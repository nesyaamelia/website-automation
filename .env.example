# ============================================================
# Environment Configuration - Website Automation
# Copy this file to .env and fill in your values
# ============================================================

# ===== APPLICATION URLs =====
BASE_URL=https://your-app-url.com
API_BASE_URL=https://api.your-app-url.com

# ===== TEST USER CREDENTIALS =====
TEST_USER_EMAIL=test.user@example.com
TEST_USER_PASSWORD=YourPassword1

# ===== PASSWORD TEST DATA =====
TEST_OLD_PASSWORD=OldPassword1
TEST_OLD_PASSWORD_ALT=OldPassword2
TEST_NEW_PASSWORD=NewPassword1
TEST_NEW_PASSWORD_SIMPLE=NewPass12
TEST_NEW_PASSWORD_MIX=NewPass123

# ===== PIN TEST DATA =====
TEST_OLD_PIN=000000
TEST_NEW_PIN=111111
TEST_CHANGE_PIN=222222

# ===== PRAKERJA TEST DATA =====
TEST_PRAKERJA_ID=1234567890123456

# ===== WHATSAPP / CONTACT =====
TEST_WHATSAPP_NUMBER=08100000000

# ===== ADMIN / API AUTH =====
QA_ADMIN_EMAIL=qa.admin@example.com
TEST_DEVICE_ID=
TEST_SOURCE_TOKEN=

# ===== EXTERNAL URLs =====
TEST_KARIER_URL=https://jobs.example.com/partner

# ===== DATABASE (for DB validation tests) =====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=db_accounts
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# ===== BROWSER SETTINGS =====
BROWSER=chromium
HEADLESS=true
SLOW_MO=0
DEFAULT_TIMEOUT=30000
